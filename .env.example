# Public URL of the site (no trailing slash). Used for canonical URLs, sitemap, OG and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.example.vn

# Only "production" allows search engines to index the site (see src/app/robots.ts).
NEXT_PUBLIC_APP_ENV=development

# Google Search Console HTML-tag verification code (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
